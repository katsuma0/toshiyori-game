{
  "name": "brain-garden",
  "version": "1.0.0",
  "private": true,
  "description": "Five gentle brain games for older adults. iPhone app built with Capacitor.",
  "scripts": {
    "start": "npx --yes http-server www -p 8080 -c-1",
    "test": "node tools/playtest.js /tmp/shots",
    "store-assets": "node tools/store-assets.js",
    "ios": "npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
